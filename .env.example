# ==============================================================================
# CloudDesk - Environment Configuration Example
# ==============================================================================
# Copy this file to .env for local development:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# NOTE: This file contains ONLY placeholders and offline defaults.
# Never commit real API keys, credentials, or sensitive secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# General & Demo Configuration
# ------------------------------------------------------------------------------
DEMO_MODE=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# In production, replace with a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-placeholder
# Optional: Supabase JWT secret (when set, takes precedence over JWT_SECRET)
SUPABASE_JWT_SECRET=

# ------------------------------------------------------------------------------
# Database & Checkpoint Persistence
# ------------------------------------------------------------------------------
# SQLite default: sqlite+aiosqlite:///./data/support.db
# PostgreSQL:     postgresql+asyncpg://user:password@localhost:5432/clouddesk
DATABASE_URL=sqlite+aiosqlite:///./data/support.db
CHECKPOINT_DB_PATH=./data/checkpoints.db

# ------------------------------------------------------------------------------
# Redis & Caching
# ------------------------------------------------------------------------------
# Leave REDIS_URL empty and set USE_FAKE_REDIS=true for offline development
REDIS_URL=
USE_FAKE_REDIS=true

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Options: fake (offline default) | openai | anthropic
LLM_PROVIDER=fake
LLM_API_KEY=your-llm-api-key-placeholder
LLM_MODEL=fake

# ------------------------------------------------------------------------------
# Embeddings & Vector Store
# ------------------------------------------------------------------------------
# Options: fake (default) | openai
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Options: memory (offline default) | qdrant
VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-placeholder
QDRANT_COLLECTION=clouddesk_knowledge

# ------------------------------------------------------------------------------
# Tool Policies & Limits
# ------------------------------------------------------------------------------
APPROVAL_REQUIRED_FOR_REFUNDS=true
MAX_REFUND_WITHOUT_APPROVAL=0
TOOL_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=120
SAMPLE_DATA_DIR=sample_data

# ------------------------------------------------------------------------------
# LangSmith / Observability (Optional)
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langchain-api-key-placeholder
LANGCHAIN_PROJECT=clouddesk-support

